[Unit]
Description=Rewrite Cinder table files so deleted rows leave the disk
Documentation=file:///opt/cinder/README.md
After=postgresql.service
Wants=postgresql.service

[Service]
Type=oneshot
User=cinder
Group=cinder
WorkingDirectory=/opt/cinder
EnvironmentFile=/opt/cinder/.env
ExecStart=/usr/bin/node scripts/compact.mjs
Nice=15
IOSchedulingClass=idle
SuccessExitStatus=75
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/opt/cinder
CapabilityBoundingSet=
